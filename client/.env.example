# EXPO_PUBLIC_* values are bundled into the app and visible to anyone.
# NEVER put API keys, database credentials or secrets here.

# Base URL of the AgentHire API.
# On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Public web URL used for shareable links
EXPO_PUBLIC_WEB_URL=http://localhost:8081
