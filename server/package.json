{
  "name": "agenthire-server",
  "version": "0.1.0",
  "private": true,
  "description": "AgentHire API — Express backend, LangGraph workflows and AI agents",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js tests/integration",
    "check:specs": "node scripts/check-specs.js",
    "ingest:knowledge": "node scripts/ingest-knowledge.js",
    "agents:dry-run": "node scripts/run-agents.js --pdf ../demo-data/resumes/john-react-resume.pdf --hiring-spec frontend-developer",
    "demo:resume": "node scripts/generate-demo-resume.js"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@langchain/core": "1.3.5",
    "@langchain/groq": "1.3.1",
    "@langchain/openai": "1.8.2",
    "@qdrant/js-client-rest": "1.20.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.12.2",
    "multer": "2.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qs": "6.17.1",
    "resend": "6.39.0",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "jest-environment-node": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.2"
  }
}
