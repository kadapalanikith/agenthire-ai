# ---------------------------------------------------------------
# AgentHire server environment. Copy to .env and fill in values.
# Never commit .env. Never put these values in the mobile app.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of proxies in front of the API (e.g. 1 behind a load balancer)
TRUST_PROXY=0

# MongoDB (local Docker Compose or a MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/agenthire

# Auth: use a long random value, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated allowed web origins (Expo web dev server, deployed web app)
CORS_ORIGINS=http://localhost:8081
# Public URL of the Expo web export (candidate apply links, password reset links)
PUBLIC_WEB_URL=http://localhost:8081
COMPANY_NAME=AgentHire

# LLM providers (used from Phase 4)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_MS=30000

# Vector database (local Docker Compose or Qdrant Cloud)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Email (Resend). When empty, emails are not sent and are recorded as "not_configured".
RESEND_API_KEY=
EMAIL_FROM=AgentHire <onboarding@resend.dev>

# Expo push notifications (Phase 8, optional)
EXPO_ACCESS_TOKEN=

# Workflow runner (Phase 5)
WORKFLOW_CONCURRENCY=2
